# =============================================================================
# BhuViveka — environment template
# Copy this file to `.env` and fill in your own credentials.
# DO NOT commit `.env` (already in .gitignore).
# =============================================================================

# --- NRSC Bhoonidhi portal credentials (required for src/data/download.py) ---
# Register at: https://bhoonidhi.nrsc.gov.in
BHOONIDHI_USER=
BHOONIDHI_PASS=

# --- Hugging Face access token (required for Prithvi-EO-2.0 download) -------
# Create one at: https://huggingface.co/settings/tokens
# Needs "read" scope on `ibm-nasa-geospatial/Prithvi-EO-2.0-300M`.
HF_TOKEN=

# --- Storage paths ----------------------------------------------------------
# Directory containing the extracted Prithvi-EO-2.0-300M weights.
# Resolved by src/models/prithvi_model.py at runtime.
MODELS_DIR=./models

# Root for raw + processed datasets (Bhoonidhi tiles, Hi-MAG labels, etc.).
DATA_ROOT=./data

# --- Optional ---------------------------------------------------------------
# Set to "1" for verbose download logging.
BHUVIVEKA_DEBUG=0
